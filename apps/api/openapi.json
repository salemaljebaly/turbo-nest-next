  "info": {
    "title": "MyApp",
    "description": "REST API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AppInfoDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "CreateUploadDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "example": "image/png"
          },
          "sizeBytes": {
            "type": "number",
            "example": 102400
          }
        },
        "required": ["mimeType", "sizeBytes"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ]
      },
      "UsersListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": ["items", "nextCursor", "hasMore"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Lamah"
          },
          "image": {
            "type": "string",
            "example": "https://example.com/avatar.png",
            "nullable": true
          }
        }
      },
      "EnqueuePingJobResponseDto": {
        "type": "object",
        "properties": {
          "queued": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["queued", "message"]
      },
      "EnqueuePingJobDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "hello from the API"
          }
        },
        "required": ["message"]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Launch checklist"
          },
          "description": {
            "type": "string",
            "example": "Tasks and notes for the first release."
          }
        },
        "required": ["name"]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Launch checklist"
          },
          "description": {
            "type": "string",
            "example": "Tasks and notes for the first release."
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived"]
          }
        }
      }
    }
  }
}
