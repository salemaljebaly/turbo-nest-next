# Domains
APP_DOMAIN=example.com
API_DOMAIN=api.example.com

# Images. Override these when pulling from a registry instead of building on the server.
API_IMAGE=turbo-nest-next-api:single-server
WEB_IMAGE=turbo-nest-next-web:single-server
WORKER_IMAGE=turbo-nest-next-worker:single-server
NODE_VERSION=22

# App URLs
APP_NAME=MyApp
APP_URL=https://example.com
CORS_ORIGINS=https://example.com
BETTER_AUTH_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_AUTH_URL=https://api.example.com

# Secrets
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Persistence
POSTGRES_USER=postgres
POSTGRES_DB=appdb
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/appdb
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
REDIS_URL=redis://:change-me@redis:6379
QUEUE_PREFIX=template

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SMOKE_TEST_ENABLED=false
METRICS_TOKEN=change-me
APP_HEALTH_URL=https://api.example.com/api/health
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_TOKEN=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_TOKEN=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MyApp <noreply@example.com>

# Backups
BACKUP_DIR=/tmp/turbo-nest-next-backups
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=template-backups
BACKUP_S3_PREFIX=single-server
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
BACKUP_RETENTION_DAYS=7
RUSTFS_BUCKET=uploads
